    <string name="onboarding_1_title">Downloads that do not give up</string>
    <string name="onboarding_1_body">F7 splits a file into real byte ranges, keeps every connection busy, and resumes exactly where it stopped.</string>
    <string name="onboarding_2_title">Eight connections, one file</string>
    <string name="onboarding_2_body">Work stealing re-splits slow ranges so one stalled connection cannot hold back the rest. Tune the count, concurrency, and speed limit whenever you like.</string>
    <string name="onboarding_3_title">Browse, grab, keep</string>
    <string name="onboarding_3_body">Catch downloads in the built-in browser, or share any link to F7. Finished files land in Library with checksums and duplicate detection.</string>
    <string name="onboarding_4_title">Private by default</string>
    <string name="onboarding_4_body">No broad storage permission: F7 writes through the Storage Access Framework or MediaStore. Notifications are the only optional permission.</string>
    <string name="settings_onboarding">Show onboarding</string>
    <string name="settings_onboarding_desc">Replay the introduction any time.</string>
