<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Download rows carry request headers, so the database is deliberately not backed up. -->
        <exclude domain="database" path="f7.db" />
        <include domain="sharedpref" path="f7_settings.xml" />
        <exclude domain="external" path="staging" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="f7.db" />
        <include domain="sharedpref" path="f7_settings.xml" />
    </device-transfer>
</data-extraction-rules>
